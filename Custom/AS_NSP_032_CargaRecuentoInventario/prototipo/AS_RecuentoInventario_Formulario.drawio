lColor=#f1f1f1;strokeColor=#aaaaaa;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="170" y="220" width="120" height="28" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Qué pasa al crear&lt;/b&gt;&lt;br&gt;• Se crea el recuento en estado Iniciado.&lt;br&gt;• Se borra el CSV temporal (también si falla).&lt;br&gt;• Desde ahí el WMS móvil lo toma para contar / completar (por probar en QA)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="620" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>