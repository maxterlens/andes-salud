+        getJournalEntriesByFolio: getJournalEntriesByFolio,
+        getJournalEntriesIndexByFolios: getJournalEntriesIndexByFolios,
+        getJournalEntriesFromIndex: getJournalEntriesFromIndex
     };
 });
